<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 崩3蓝：崩坏3 深蓝主色调 -->
    <SolidColorBrush x:Key="SidebarBg" Color="#E616325B"/>
    <SolidColorBrush x:Key="SidebarFg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SidebarDim" Color="#BFD4F2"/>
    <SolidColorBrush x:Key="NavHoverBg" Color="#4D1F4A85"/>
    <SolidColorBrush x:Key="NavActiveBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="NavActiveFg" Color="#16325B"/>
    <SolidColorBrush x:Key="NavBorder" Color="#16325B"/>

    <!-- 页面背景（苹果式渐变） -->
    <LinearGradientBrush x:Key="PageBg" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#EAF1FB" Offset="0"/>
        <GradientStop Color="#D3D9E2" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBorder" Color="#1A000000"/>
    <SolidColorBrush x:Key="InputBg" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="TextPrimary" Color="#16202E"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#54657E"/>
    <SolidColorBrush x:Key="TextOnAccent" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="Accent" Color="#2456A6"/>
    <SolidColorBrush x:Key="AccentHover" Color="#1B4486"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#E2ECFA"/>

    <SolidColorBrush x:Key="ButtonBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ButtonBgHover" Color="#EDF4FD"/>
    <SolidColorBrush x:Key="ButtonFg" Color="#2456A6"/>
    <SolidColorBrush x:Key="ButtonBorder" Color="#33000000"/>

    <SolidColorBrush x:Key="Danger" Color="#E5484D"/>
    <SolidColorBrush x:Key="Success" Color="#30A46C"/>
    <SolidColorBrush x:Key="Warning" Color="#FFB224"/>

    <DropShadowEffect x:Key="CardShadow" BlurRadius="24" ShadowDepth="0" Direction="270" Opacity="0.14" Color="#000000"/>
</ResourceDictionary>
