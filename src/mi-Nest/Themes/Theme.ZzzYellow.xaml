<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 绝区零黄 -->
    <SolidColorBrush x:Key="SidebarBg" Color="#E64A3A00"/>
    <SolidColorBrush x:Key="SidebarFg" Color="#FFF3C4"/>
    <SolidColorBrush x:Key="SidebarDim" Color="#BFA25A"/>
    <SolidColorBrush x:Key="NavHoverBg" Color="#4D5A4600"/>
    <SolidColorBrush x:Key="NavActiveBg" Color="#FFD666"/>
    <SolidColorBrush x:Key="NavActiveFg" Color="#403000"/>
    <SolidColorBrush x:Key="NavBorder" Color="#4A3A00"/>

    <!-- 页面背景（苹果式渐变） -->
    <LinearGradientBrush x:Key="PageBg" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFAEA" Offset="0"/>
        <GradientStop Color="#E6E1D3" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBorder" Color="#1A000000"/>
    <SolidColorBrush x:Key="InputBg" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="TextPrimary" Color="#33290A"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#8D7A45"/>
    <SolidColorBrush x:Key="TextOnAccent" Color="#403000"/>

    <SolidColorBrush x:Key="Accent" Color="#D9A406"/>
    <SolidColorBrush x:Key="AccentHover" Color="#B88A03"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#FBF0D2"/>

    <SolidColorBrush x:Key="ButtonBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ButtonBgHover" Color="#FAF1D8"/>
    <SolidColorBrush x:Key="ButtonFg" Color="#8A6D1F"/>
    <SolidColorBrush x:Key="ButtonBorder" Color="#33000000"/>

    <SolidColorBrush x:Key="Danger" Color="#D64045"/>
    <SolidColorBrush x:Key="Success" Color="#4C9A2A"/>
    <SolidColorBrush x:Key="Warning" Color="#E8B30C"/>

    <DropShadowEffect x:Key="CardShadow" BlurRadius="24" ShadowDepth="0" Direction="270" Opacity="0.14" Color="#000000"/>
</ResourceDictionary>
