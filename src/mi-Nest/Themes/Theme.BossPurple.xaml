<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 御姐紫：深紫侧栏 + 薰衣草雾面页面，冷静克制 -->
    <SolidColorBrush x:Key="SidebarBg" Color="#E6241830"/>
    <SolidColorBrush x:Key="SidebarFg" Color="#F3EBFF"/>
    <SolidColorBrush x:Key="SidebarDim" Color="#B39DD0"/>
    <SolidColorBrush x:Key="NavHoverBg" Color="#4D3A2A55"/>
    <SolidColorBrush x:Key="NavActiveBg" Color="#5B3E8E"/>
    <SolidColorBrush x:Key="NavActiveFg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="NavBorder" Color="#1C1230"/>

    <!-- 页面背景（薰衣草雾面） -->
    <LinearGradientBrush x:Key="PageBg" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F6F1FA" Offset="0"/>
        <GradientStop Color="#EFE6F6" Offset="0.45"/>
        <GradientStop Color="#E4D8EF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBorder" Color="#14000000"/>
    <SolidColorBrush x:Key="InputBg" Color="#FAF6FD"/>

    <SolidColorBrush x:Key="TextPrimary" Color="#2A1B3D"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#77658C"/>
    <SolidColorBrush x:Key="TextOnAccent" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="Accent" Color="#7A4BCB"/>
    <SolidColorBrush x:Key="AccentHover" Color="#6136B0"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#EDE2FB"/>

    <SolidColorBrush x:Key="ButtonBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ButtonBgHover" Color="#F3ECFB"/>
    <SolidColorBrush x:Key="ButtonFg" Color="#6C3FB8"/>
    <SolidColorBrush x:Key="ButtonBorder" Color="#33000000"/>

    <SolidColorBrush x:Key="Danger" Color="#E5484D"/>
    <SolidColorBrush x:Key="Success" Color="#30A46C"/>
    <SolidColorBrush x:Key="Warning" Color="#FFB224"/>

    <DropShadowEffect x:Key="CardShadow" BlurRadius="24" ShadowDepth="0" Direction="270" Opacity="0.15" Color="#000000"/>
</ResourceDictionary>
