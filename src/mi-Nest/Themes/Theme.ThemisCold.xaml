<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 未定冷：未定事件簿 冷色调深蓝（科技感 / 律政悬疑氛围） -->
    <SolidColorBrush x:Key="SidebarBg" Color="#E6101B33"/>
    <SolidColorBrush x:Key="SidebarFg" Color="#E8EEF8"/>
    <SolidColorBrush x:Key="SidebarDim" Color="#93A7CC"/>
    <SolidColorBrush x:Key="NavHoverBg" Color="#521D3057"/>
    <SolidColorBrush x:Key="NavActiveBg" Color="#3A6DBE"/>
    <SolidColorBrush x:Key="NavActiveFg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="NavBorder" Color="#101B33"/>

    <!-- 页面背景（冷雾渐变，顶部透出一点天光） -->
    <LinearGradientBrush x:Key="PageBg" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F1F5FB" Offset="0"/>
        <GradientStop Color="#E3E9F2" Offset="0.42"/>
        <GradientStop Color="#CFD5DE" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBorder" Color="#14000000"/>
    <SolidColorBrush x:Key="InputBg" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="TextPrimary" Color="#141D2E"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#5A6B85"/>
    <SolidColorBrush x:Key="TextOnAccent" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="Accent" Color="#2E5EAA"/>
    <SolidColorBrush x:Key="AccentHover" Color="#214A8C"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#DDE8FA"/>

    <SolidColorBrush x:Key="ButtonBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ButtonBgHover" Color="#EAF0FA"/>
    <SolidColorBrush x:Key="ButtonFg" Color="#2E5EAA"/>
    <SolidColorBrush x:Key="ButtonBorder" Color="#33000000"/>

    <SolidColorBrush x:Key="Danger" Color="#E5484D"/>
    <SolidColorBrush x:Key="Success" Color="#30A46C"/>
    <SolidColorBrush x:Key="Warning" Color="#FFB224"/>

    <DropShadowEffect x:Key="CardShadow" BlurRadius="24" ShadowDepth="0" Direction="270" Opacity="0.14" Color="#000000"/>
</ResourceDictionary>
