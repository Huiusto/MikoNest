<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 侧边栏 -->
    <SolidColorBrush x:Key="SidebarBg" Color="#E61C1F26"/>
    <SolidColorBrush x:Key="SidebarFg" Color="#E8EAED"/>
    <SolidColorBrush x:Key="SidebarDim" Color="#8B93A3"/>
    <SolidColorBrush x:Key="NavHoverBg" Color="#4D262B34"/>
    <SolidColorBrush x:Key="NavActiveBg" Color="#2B3A55"/>
    <SolidColorBrush x:Key="NavActiveFg" Color="#6FA8FF"/>
    <SolidColorBrush x:Key="NavBorder" Color="#2A2F38"/>

    <!-- 页面 -->
    <!-- 页面背景（苹果式渐变） -->
    <LinearGradientBrush x:Key="PageBg" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#12141A" Offset="0"/>
        <GradientStop Color="#101217" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CardBg" Color="#1C1F26"/>
    <SolidColorBrush x:Key="CardBorder" Color="#2A2F38"/>
    <SolidColorBrush x:Key="InputBg" Color="#16181E"/>

    <!-- 文字 -->
    <SolidColorBrush x:Key="TextPrimary" Color="#E8EAED"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#8B93A3"/>
    <SolidColorBrush x:Key="TextOnAccent" Color="#FFFFFF"/>

    <!-- 主题强调 -->
    <SolidColorBrush x:Key="Accent" Color="#3B82F6"/>
    <SolidColorBrush x:Key="AccentHover" Color="#2F6FE0"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#23304A"/>

    <!-- 控件 -->
    <SolidColorBrush x:Key="ButtonBg" Color="#262B34"/>
    <SolidColorBrush x:Key="ButtonBgHover" Color="#2F3542"/>
    <SolidColorBrush x:Key="ButtonFg" Color="#E8EAED"/>
    <SolidColorBrush x:Key="ButtonBorder" Color="#363C47"/>

    <!-- 状态 -->
    <SolidColorBrush x:Key="Danger" Color="#E5484D"/>
    <SolidColorBrush x:Key="Success" Color="#46A758"/>
    <SolidColorBrush x:Key="Warning" Color="#FFB224"/>

    <DropShadowEffect x:Key="CardShadow" BlurRadius="24" ShadowDepth="0" Direction="270" Opacity="0.14" Color="#000000"/>
</ResourceDictionary>
