<UserControl x:Class="MiNest.Pages.MhyLinksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Margin="26,22,26,20">
        <StackPanel>

            <!-- 标题区 -->
            <TextBlock Text="米哈游相关" FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock Text="以下链接均在软件内打开，不会跳转外部浏览器。点击链接右上角 📌 可固定到左侧项目栏。"
                       Margin="0,6,0,0" FontSize="12"
                       Foreground="{DynamicResource TextSecondary}"/>

            <!-- 9 个主入口：3×3 -->
            <primitives:UniformGrid x:Name="MainLinksGrid" Rows="3" Columns="3"
                                    Height="408" Margin="0,14,0,0"/>

            <!-- 第三方工具分区 -->
            <TextBlock Text="第三方工具" FontSize="15" FontWeight="SemiBold" Margin="0,18,0,0"
                       Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock Text="独立工具站，全部在软件内打开。🔝 可将常用工具置顶到本分区最前面（仅页内排序，不占用左侧项目栏）。"
                       Margin="0,4,0,0" FontSize="11.5"
                       Foreground="{DynamicResource TextSecondary}"/>
            <WrapPanel x:Name="ToolsPanel" Margin="0,10,0,0"/>

            <!-- 原神 B 服玩家请愿：单独置底整行 -->
            <Button x:Name="BtnPetition" Height="76" Margin="0,16,0,0"
                    FontSize="18" Content="原神 B 服玩家请愿（change.org/GenshinImpact）"
                    Style="{StaticResource AccentButton}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
