<UserControl x:Class="MiNest.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="26,22,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource TitleAccentBar}"/>
                <TextBlock Text="设置" Style="{StaticResource PageTitleText}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="访问项目主页 (GitHub)" Padding="14,7" Margin="0,0,10,0"
                        Style="{StaticResource AccentButton}"
                        Click="BtnRepoHome_Click"/>
                <Button Content="开发者首页（支持、讨论、问题反馈）" Padding="14,7"
                        Style="{StaticResource AccentButton}"
                        Click="BtnDevHome_Click"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1180" HorizontalAlignment="Left">

                <!-- 界面不透明度（滑动条 0-100）：控制卡片 / 框框背景 -->
                <Border Style="{StaticResource SurfaceCard}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="界面不透明度" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="拖动滑动条调整页面中卡片、输入框等「框框」背景的不透明度：0 = 完全透明（只看到文字），100 = 主题原色。"
                                   FontSize="11.5" Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="0" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Slider x:Name="SldOpacity" Grid.Column="1" Minimum="0" Maximum="100"
                                    TickFrequency="5" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="界面不透明度"
                                    ValueChanged="Opacity_Changed"/>
                            <TextBlock x:Name="TxtOpacityVal" Grid.Column="2" Text="100%"
                                       FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="44"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 界面配色 + 语言切换 + 应用维护 -->
                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" VerticalAlignment="Top" Style="{StaticResource SurfaceCard}" Padding="18,14">
                        <StackPanel>
                            <TextBlock Text="界面配色" Style="{StaticResource SectionTitle}"/>
                            <WrapPanel x:Name="ThemePanel"/>
                            <TextBlock Text="「跟随系统」会按 Windows 浅色/深色模式自动在白色与黑色之间切换；其他主题仅调整应用界面配色，网页内容（米游社等）保持原站风格。"
                                       FontSize="11.5" Foreground="{DynamicResource TextSecondary}"
                                       Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- 语言切换：点「切换」按钮，在浮层里自选语言（浮层不占布局） -->
                    <Border Grid.Column="1" Width="236" VerticalAlignment="Top" Margin="12,0,0,0"
                            Style="{StaticResource SurfaceCard}" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="语言切换" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="TxtLangCurrent" Text="当前：跟随系统"
                                       FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Text="点「切换」在浮层中选择语言"
                                       FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <Button x:Name="BtnLangToggle" Content="切换" Width="112" Margin="0,10,0,0"
                                    Padding="12,6" Style="{StaticResource AccentButton}"
                                    Click="BtnLangToggle_Click"/>
                            <TextBlock Text="切换后重新打开软件生效" FontSize="11" Margin="0,8,0,0"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"/>
                            <Popup x:Name="LangDrawer" PlacementTarget="{Binding ElementName=BtnLangToggle}"
                                   Placement="Bottom" StaysOpen="True" AllowsTransparency="True" Closed="LangDrawer_Closed"
                                   PopupAnimation="Fade" VerticalOffset="10" HorizontalOffset="0">
                                <Border CornerRadius="12" Padding="12,10" MinWidth="236"
                                        Background="{DynamicResource InputBg}"
                                        BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270"
                                                          Opacity="0.24" Color="#000000"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <ScrollViewer MaxHeight="310" VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel x:Name="LangPanel"/>
                                        </ScrollViewer>
                                        <TextBlock x:Name="TxtLangHint" FontSize="11" Margin="2,8,2,0"
                                                   TextWrapping="Wrap" Visibility="Collapsed"
                                                   Foreground="{DynamicResource Accent}"/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Width="236" VerticalAlignment="Top" Margin="12,0,0,0"
                            Style="{StaticResource SurfaceCard}" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="应用维护" Style="{StaticResource SectionTitle}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                    Margin="0,2,0,8" ToolTip="控制左侧「账号」按钮是否显示">
                            <TextBlock Text="账号入口" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <ToggleButton x:Name="TglAccountNav" Margin="8,0,0,0"
                                          Style="{StaticResource SwitchToggle}"
                                          Checked="AccountNav_Changed" Unchecked="AccountNav_Changed"/>
                        </StackPanel>
                        <Button x:Name="BtnUpdate" Content="检查更新" Width="128" Padding="12,6" Style="{StaticResource AccentButton}"
                                Click="BtnUpdate_Click"/>
                        <TextBlock x:Name="TxtUpdateHint" Width="128" Margin="0,4,0,0" FontSize="11"
                                   TextAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed"
                                   Foreground="{DynamicResource TextSecondary}"/>
                        <Button Content="卸载 mi-Nest" Width="128" Padding="12,6" Margin="0,6,0,0"
                                Style="{StaticResource DangerButton}" Click="BtnUninstall_Click"/>
                    </StackPanel>
                    </Border>
                </Grid>

                <!-- 管理项目栏 + 通用设置（同一栏两列） -->
                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左：管理项目栏 -->
                    <Border Grid.Column="0" Style="{StaticResource SurfaceCard}" Padding="18" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="管理项目栏" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="调整左侧导航从上到下的顺序；📌 固定项来自「米哈游相关」页面，点击右侧 ✕ 可移除。"
                                       FontSize="11.5" Foreground="{DynamicResource TextSecondary}"
                                       Margin="0,6,0,0" TextWrapping="Wrap"/>
                            <StackPanel x:Name="NavManagerPanel" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 右：通用设置 -->
                    <Border Grid.Column="1" Style="{StaticResource SurfaceCard}" Padding="18" Margin="10,0,0,0">
                        <StackPanel>
                            <TextBlock Text="通用设置" Style="{StaticResource SectionTitle}"/>

                            <TextBlock Text="启动设置" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" Margin="0,14,0,0"/>
                            <CheckBox x:Name="ChkAutoStart" Content="开机自动运行 mi-Nest"
                                      Margin="0,8,0,0" FontSize="13"
                                      Foreground="{DynamicResource TextPrimary}"
                                      Checked="ChkAutoStart_Changed" Unchecked="ChkAutoStart_Changed"/>
                            <TextBlock Text="开启后，登录 Windows 时将自动在后台启动本启动器。"
                                       FontSize="11.5" Foreground="{DynamicResource TextSecondary}"
                                       Margin="0,4,0,0" TextWrapping="Wrap"/>
                            <CheckBox x:Name="ChkBringFront" Content="退出游戏后自动弹出启动器主界面"
                                      Margin="0,12,0,0" FontSize="13"
                                      Foreground="{DynamicResource TextPrimary}"
                                      Checked="ChkBringFront_Changed" Unchecked="ChkBringFront_Changed"/>
                            <TextBlock Text="开启后，检测到米哈游游戏（原神 / 星穹铁道 / 绝区零 / 崩坏3）退出时，自动把本启动器弹出到前台并回到「启动」页。"
                                       FontSize="11.5" Foreground="{DynamicResource TextSecondary}"
                                       Margin="0,4,0,0" TextWrapping="Wrap"/>

                            <TextBlock Text="关闭设置" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" Margin="0,18,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <RadioButton x:Name="RdoCloseTray" GroupName="closeBehavior"
                                             Content="最小化到系统托盘" FontSize="13"
                                             Foreground="{DynamicResource TextPrimary}"
                                             Margin="0,0,28,0"
                                             Checked="CloseBehavior_Changed"/>
                                <RadioButton x:Name="RdoCloseExit" GroupName="closeBehavior"
                                             Content="退出启动器" FontSize="13"
                                             Foreground="{DynamicResource TextPrimary}"
                                             Checked="CloseBehavior_Changed"/>
                            </StackPanel>
                            <TextBlock Text="点击窗口右上角关闭按钮（×）时：最小化到系统托盘会在后台继续运行，双击托盘图标可恢复；退出启动器则直接结束进程。"
                                       FontSize="11.5" Foreground="{DynamicResource TextSecondary}"
                                       Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 账号管理已移至左侧导航栏「账号」独立页面 -->

                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 应用信息 -->
                    <Border Grid.Column="0" Style="{StaticResource SurfaceCard}" Padding="18" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="应用信息" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="以下是本应用的版本与数据存储信息。"
                                       FontSize="11.5" Foreground="{DynamicResource TextSecondary}"
                                       Margin="0,6,0,0" TextWrapping="Wrap"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="名称" Foreground="{DynamicResource TextSecondary}" Margin="0,4"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="mi-Nest（米哈游 PC 多功能桌面客户端）"
                                           Foreground="{DynamicResource TextPrimary}" Margin="0,4" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="1" Text="版本" Foreground="{DynamicResource TextSecondary}" Margin="0,4"/>
                                <TextBlock x:Name="TxtVersion" Grid.Row="1" Grid.Column="1"
                                           Foreground="{DynamicResource TextPrimary}" Margin="0,4"/>
                                <TextBlock Grid.Row="2" Text="框架" Foreground="{DynamicResource TextSecondary}" Margin="0,4"/>
                                <TextBlock Grid.Row="2" Grid.Column="1"
                                           Text=".NET 9 · WPF · WebView2（Windows 10/11）"
                                           Foreground="{DynamicResource TextPrimary}" Margin="0,4" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="3" Text="数据目录" Foreground="{DynamicResource TextSecondary}" Margin="0,4"/>
                                <TextBlock x:Name="TxtDataDir" Grid.Row="3" Grid.Column="1" Foreground="{DynamicResource TextPrimary}"
                                           Margin="0,4" TextWrapping="Wrap" FontSize="12"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="应用的所有数据（设置、账号登录态、抽卡记录、签到状态等）都保存在此文件夹，建议定期备份；更改数据目录后需重启 mi-Nest 生效，原有数据不会自动迁移。"
                                           Foreground="{DynamicResource TextSecondary}" FontSize="11.5"
                                           Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <Button Grid.Row="5" Grid.Column="1" Content="打开数据目录" HorizontalAlignment="Left"
                                        Padding="14,6" Margin="0,10,12,0" Click="BtnOpenDataDir_Click"/>
                                <Button Grid.Row="5" Grid.Column="1" Content="更改数据目录" HorizontalAlignment="Left"
                                        Padding="14,6" Margin="128,10,0,0" Click="BtnChangeDataDir_Click"/>
                                <Button Grid.Row="6" Grid.Column="1" Content="📌 实时便笺（米哈游游戏实时状态、体力查询）"
                                        HorizontalAlignment="Left"
                                        Padding="14,6" Margin="0,10,0,0" Click="BtnDailyNote_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 右列：关于 -->
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <Border Style="{StaticResource SurfaceCard}" Padding="18">
                            <StackPanel>
                                <TextBlock Text="关于" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="mi-Nest 是一款开源的米哈游 PC 多功能桌面客户端，把米哈游游戏的启动、社区浏览、抽卡记录、每日任务与签到、官方及第三方站点聚合到一个软件内，所有页面均在应用内打开，无需跳转浏览器。"
                                           Foreground="{DynamicResource TextSecondary}" FontSize="12.5"
                                           TextWrapping="Wrap" LineHeight="20"/>

                                <TextBlock Text="开源说明" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" Margin="0,14,0,0"/>
                                <TextBlock Text="源码完全开源，欢迎查阅与贡献。参考了 Starward（Scighost，MIT）与 TeyvatGuide（BTMuli，MIT）的实现思路，代码均在本项目内自行编写。"
                                           Foreground="{DynamicResource TextSecondary}" FontSize="12.5"
                                           TextWrapping="Wrap" LineHeight="20" Margin="0,6,0,0"/>

                                <TextBlock Text="免责声明" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" Margin="0,14,0,0"/>
                                <TextBlock Text="本项目为个人开源项目，与米哈游官方无关。任务 / 签到等接口为社区公开接口，官方可能随时调整导致部分功能失效，届时需要更新参数后才能继续使用。此外，本软件聚合了大量第三方工具与站点，它们由各自的开发者独立维护，其任何问题（包括服务可用性、数据安全、使用后果等）均与本软件无关，请在使用前自行了解其用途与风险。请勿滥用接口，注意账号安全。"
                                           Foreground="{DynamicResource TextSecondary}" FontSize="12.5"
                                           TextWrapping="Wrap" LineHeight="20" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- mi-Nest 隐藏设置入口（放到设置页最底部） -->
                <Border Style="{StaticResource SurfaceCard}" Padding="18" Margin="0,18,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="mi-Nest" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondary}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Button x:Name="BtnHidden" Content="隐藏设置" Padding="14,6"
                                    Click="BtnHidden_Click"/>
                        </StackPanel>

                        <Border x:Name="HiddenPanel" Visibility="Collapsed" Margin="0,14,0,0"
                                Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="1" CornerRadius="10" Padding="16">
                            <StackPanel>
                                <TextBlock Text="请输入访问密码" FontSize="13"
                                           Foreground="{DynamicResource TextSecondary}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <PasswordBox x:Name="TxtPwd" Width="220" VerticalContentAlignment="Center"
                                                 AutomationProperties.Name="访问密码"
                                                 KeyDown="TxtPwd_KeyDown"/>
                                    <Button Content="进入" Padding="16,5" Margin="10,0,0,0"
                                            Click="BtnPwdOk_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtPwdErr" Foreground="#E0506E" FontSize="12"
                                           Margin="0,8,0,0" Visibility="Collapsed"/>

                                <StackPanel x:Name="HiddenSettings" Visibility="Collapsed" Margin="0,14,0,0">
                                    <TextBlock Text="隐藏设置" FontSize="14" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="可单独控制左侧导航栏的内置项目是否显示（默认全部显示）；「账号」「设置」固定显示。"
                                               FontSize="11.5" Foreground="{DynamicResource TextSecondary}"
                                               Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="左侧项目栏显示开关" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" Margin="0,12,0,0"/>
                                    <CheckBox x:Name="ChkNavLaunch" Content="显示「启动」"
                                              Margin="0,8,0,0" FontSize="13"
                                              Foreground="{DynamicResource TextPrimary}"
                                              Tag="启动"
                                              Checked="NavVisibility_Changed" Unchecked="NavVisibility_Changed"/>
                                    <CheckBox x:Name="ChkNavCommunity" Content="显示「社区」"
                                              Margin="0,6,0,0" FontSize="13"
                                              Foreground="{DynamicResource TextPrimary}"
                                              Tag="社区"
                                              Checked="NavVisibility_Changed" Unchecked="NavVisibility_Changed"/>
                                    <CheckBox x:Name="ChkNavGacha" Content="显示「抽卡记录」"
                                              Margin="0,6,0,0" FontSize="13"
                                              Foreground="{DynamicResource TextPrimary}"
                                              Tag="抽卡记录"
                                              Checked="NavVisibility_Changed" Unchecked="NavVisibility_Changed"/>
                                    <CheckBox x:Name="ChkNavTask" Content="显示「任务/签到」"
                                              Margin="0,6,0,0" FontSize="13"
                                              Foreground="{DynamicResource TextPrimary}"
                                              Tag="任务/签到"
                                              Checked="NavVisibility_Changed" Unchecked="NavVisibility_Changed"/>
                                    <CheckBox x:Name="ChkNavNote" Content="显示「实时便笺」"
                                              Margin="0,6,0,0" FontSize="13"
                                              Foreground="{DynamicResource TextPrimary}"
                                              Tag="实时便笺"
                                              Checked="NavVisibility_Changed" Unchecked="NavVisibility_Changed"/>
                                    <CheckBox x:Name="ChkNavLinks" Content="显示「米哈游相关」"
                                              Margin="0,6,0,0" FontSize="13"
                                              Foreground="{DynamicResource TextPrimary}"
                                              Tag="米哈游相关"
                                              Checked="NavVisibility_Changed" Unchecked="NavVisibility_Changed"/>

                                    <TextBlock Text="界面配色（胡桃）" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" Margin="0,18,0,0"/>
                                    <CheckBox x:Name="ChkHutaoTheme" Content="胡桃红 · 暖奶油底 + 胡桃红强调色"
                                              Margin="0,8,0,0" FontSize="13"
                                              Foreground="{DynamicResource TextPrimary}"
                                              Checked="HutaoTheme_Changed" Unchecked="HutaoTheme_Changed"/>
                                    <CheckBox x:Name="ChkHutaoBackdrop" Content="胡桃风格背景 · 用胡桃主题插画作为应用背景"
                                              Margin="0,8,0,0" FontSize="13"
                                              Foreground="{DynamicResource TextPrimary}"
                                              Checked="HutaoBackdrop_Changed" Unchecked="HutaoBackdrop_Changed"/>
                                    <TextBlock Text="两项可同时开启：背景插画铺在内容区底层，卡片与文字保持可读；关闭「胡桃红」会恢复为白色配色。"
                                               FontSize="11.5" Foreground="{DynamicResource TextSecondary}"
                                               Margin="0,6,0,0" TextWrapping="Wrap"/>

                                    <TextBlock Text="自定义软件背景图" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" Margin="0,18,0,0"/>
                                    <TextBlock Text="选择一张图片铺满整个软件窗口（位于所有页面下层）；「胡桃风格背景」开启时以自定义背景为准。"
                                               FontSize="11.5" Foreground="{DynamicResource TextSecondary}"
                                               Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button x:Name="BtnPickAppBg" Content="选择背景图" Padding="14,6"
                                                Click="BtnPickAppBg_Click"/>
                                        <Button x:Name="BtnClearAppBg" Content="恢复默认背景" Padding="14,6"
                                                Margin="8,0,0,0" Click="BtnClearAppBg_Click"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtAppBgName" Text="当前：未设置"
                                               FontSize="11.5" Foreground="{DynamicResource TextSecondary}"
                                               Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Text="背景上方蒙版" FontSize="12.5" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,10,0"/>
                                        <Slider x:Name="SldAppBgVeil" Width="210" Minimum="0" Maximum="100"
                                                TickFrequency="5" IsSnapToTickEnabled="True"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="自定义背景蒙版浓度"
                                                ValueChanged="AppBgVeil_Changed"/>
                                        <TextBlock x:Name="TxtAppBgVeil" Text="70%" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}" Margin="10,0,0,0"
                                                   VerticalAlignment="Center" MinWidth="40"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
