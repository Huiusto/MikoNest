<UserControl x:Class="MiNest.Pages.TaskPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="26,22,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 头部：标题 + 操作按钮 -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="PageTitle" Text="任务 / 签到" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                <TextBlock Text="米游社各板块签到福利 · 米游币每日任务" FontSize="12.5"
                           Foreground="{DynamicResource TextSecondary}" Margin="14,1,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="BtnSignGames" Content="签到全部游戏" Padding="14,7" Click="BtnSignGames_Click"/>
                <Button x:Name="BtnBbs" Content="米游币每日任务" Padding="14,7" Margin="8,0,0,0" Click="BtnBbs_Click"/>
                <Button x:Name="BtnAllAccounts" Content="一键完成所有账号" Padding="18,8" Margin="10,0,0,0"
                        Style="{StaticResource AccentButton}" Click="BtnAllAccounts_Click"/>
            </StackPanel>
        </Grid>

        <!-- 账号卡片 -->
        <Border Grid.Row="1" Margin="0,16,0,0" Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                CornerRadius="12" Padding="16,12" Effect="{DynamicResource CardShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="当前账号" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CmbAccount" Width="230" Margin="12,0,0,0" VerticalAlignment="Center"
                                  DisplayMemberPath="DisplayName" SelectionChanged="CmbAccount_SelectionChanged"/>
                        <Button x:Name="BtnRefreshStatus" Content="刷新状态" Margin="10,0,0,0" Padding="12,5"
                                Click="BtnRefreshStatus_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtAccountStatus" HorizontalAlignment="Right" VerticalAlignment="Center"
                               FontSize="12.5" FontWeight="SemiBold"/>
                </Grid>
                <Border x:Name="BannerStoken" Grid.Row="1" Margin="0,10,0,0"
                        Background="{DynamicResource AccentSoft}" CornerRadius="8" Padding="10,7"
                        Visibility="Collapsed">
                    <TextBlock x:Name="TxtAccountHint" FontSize="12" Foreground="{DynamicResource TextPrimary}"
                               TextWrapping="Wrap"/>
                </Border>
            </Grid>
        </Border>

        <!-- 游戏签到小节标题 -->
        <Grid Grid.Row="2" Margin="0,18,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="游戏签到" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                <TextBlock Text="点击卡片右上角按钮即可为该游戏全部角色签到" FontSize="12"
                           Foreground="{DynamicResource TextSecondary}" Margin="10,1,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- 游戏卡片区（可滚动） -->
        <ScrollViewer Grid.Row="3" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <WrapPanel x:Name="GameRowsPanel"/>
        </ScrollViewer>

        <!-- 执行日志 -->
        <Border Grid.Row="4" Margin="0,14,0,0" Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                CornerRadius="12" Padding="4" Effect="{DynamicResource CardShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="14,10,10,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="执行日志" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtLogCount" FontSize="11.5" Margin="8,1,0,0"
                                   Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="清空日志" FontSize="11.5" Padding="10,4"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Click="BtnClearLog_Click"/>
                </Grid>
                <ListBox x:Name="LogList" Grid.Row="1" Margin="6,0,6,8" BorderThickness="0"
                         MaxHeight="220"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="12.5" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
