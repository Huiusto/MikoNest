<UserControl x:Class="MiNest.Pages.AccountPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="26,22,26,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="292"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左：账号列表（管理账号，单击即快速切换） -->
        <Border Grid.Column="0" Style="{StaticResource SurfaceCard}" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                <Grid Margin="2,0,2,4">
                    <TextBlock Text="管理账号" FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtAccountCount" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="单击账号即可切换当前账号"
                           FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="2,0,0,10"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="TxtStokenHint" Margin="2,0,0,10" FontSize="11.5" TextWrapping="Wrap"
                           Foreground="#E6A23C" Visibility="Collapsed"
                           Text="⚠ 当前账号登录态缺少 stoken（抽卡记录 / 签到 / 米游币任务必需）。请用「扫码登录」或「Cookie 登录」重新登录，功能即可恢复。"/>
                </StackPanel>
                <ListBox x:Name="AccountList" Grid.Row="1" SelectionChanged="AccountList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Display}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="✓ 当前" FontSize="11" VerticalAlignment="Center"
                                           Margin="10,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Setter Property="Foreground" Value="#00AEEC"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="⚠ 缺 stoken" FontSize="10.5" Foreground="#E6A23C"
                                               ToolTip="缺少 stoken，抽卡记录 / 签到不可用，请重新登录">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasStoken}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,7"/>
                            <Setter Property="Margin" Value="0,1"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="BtnSetActive" Content="设为当前" Width="96" Click="BtnSetActive_Click"/>
                    <Button x:Name="BtnDelete" Content="删除" Width="80" Margin="8,0,0,0"
                            Style="{StaticResource DangerButton}" Click="BtnDelete_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 右：登录方式（仿 TeyvatGuide：扫码 / 验证码 / Cookie，支持多账号） -->
        <ScrollViewer Grid.Column="1" Margin="16,0,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="2,2,0,16">
                    <Border Style="{StaticResource TitleAccentBar}"/>
                    <TextBlock Text="账号" Style="{StaticResource PageTitleText}" VerticalAlignment="Center"/>
                    <TextBlock Text="支持扫码 / 验证码 / Cookie，可同时管理多个账号"
                               FontSize="12" Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center" Margin="14,0,0,0"/>
                </StackPanel>

                <!-- 网页扫码登录（推荐，官方页面 100% 可用） -->
                <Border Style="{StaticResource SurfaceCard}" Padding="18" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="网页扫码登录（推荐）" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="在软件内打开米游社官方登录页，使用手机「米游社」App 扫码（或手机号验证码）登录，成功后自动导入账号，最稳定。"
                                   FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,0"
                                   TextWrapping="Wrap" MaxWidth="520"/>
                        <Button x:Name="BtnWebLogin" Content="打开官方登录页并自动导入"
                                Style="{StaticResource AccentButton}" Padding="16,8" Margin="0,12,0,0"
                                Click="BtnWebLogin_Click"/>
                        <TextBlock x:Name="WebLoginStatus" Margin="0,10,0,0" FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 扫码登录 + 验证码登录（同一栏） -->
                <Border Style="{StaticResource SurfaceCard}" Padding="18" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左：扫码登录 -->
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="扫码登录（米哈游通行证 App）" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Border x:Name="QrFrame" Width="176" Height="176" CornerRadius="12"
                                        Background="{DynamicResource InputBg}"
                                        BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Effect="{DynamicResource CardShadow}">
                                    <Image x:Name="QrImage" Width="160" Height="160" Stretch="Uniform"/>
                                </Border>
                                <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="QrStatus" FontSize="12.5"
                                               Foreground="{DynamicResource TextSecondary}"
                                               TextWrapping="Wrap" MaxWidth="280"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button x:Name="BtnQrStart" Content="开始扫码" Style="{StaticResource AccentButton}"
                                                Padding="16,7" Click="BtnQrStart_Click"/>
                                        <Button x:Name="BtnQrCancel" Content="取消" Margin="8,0,0,0"
                                                Padding="16,7" Click="BtnQrCancel_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="1" Width="1" Margin="0,4"
                                Background="{DynamicResource CardBorder}"/>

                        <!-- 右：验证码登录 -->
                        <StackPanel Grid.Column="2" Margin="10,0,0,0">
                            <TextBlock Text="验证码登录（手机号）" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <TextBox x:Name="TxtMobile" Width="200" ToolTip="手机号"
                                         AutomationProperties.Name="手机号"/>
                                <Button x:Name="BtnSendCode" Content="发送验证码" Margin="8,0,0,0"
                                        Click="BtnSendCode_Click"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBox x:Name="TxtSmsCode" Width="140" ToolTip="验证码"
                                         AutomationProperties.Name="短信验证码"/>
                                <Button x:Name="BtnSmsLogin" Content="登录" Style="{StaticResource AccentButton}"
                                        Margin="8,0,0,0" Click="BtnSmsLogin_Click"/>
                                <TextBlock x:Name="SmsStatus" VerticalAlignment="Center" Margin="14,0,0,0"
                                           FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                            </StackPanel>
                            <TextBlock Text="说明：若官方要求图形验证码，此方式可能不可用，请改用扫码或 Cookie。"
                                       FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,8,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Cookie 登录 -->
                <Border Style="{StaticResource SurfaceCard}" Padding="18" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Cookie 登录" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="在浏览器中登录 miyoushe.com 后，复制 Cookie（如 cookie_token=xxx; account_id=xxx; …）粘贴到下方。"
                                   FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"
                                   TextWrapping="Wrap"/>
                        <TextBox x:Name="TxtCookie" Margin="0,10,0,0" MinHeight="56"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 ToolTip="粘贴登录后的 Cookie（如 cookie_token=xxx; account_id=xxx; …）"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="BtnCookieAdd" Content="验证并添加" Style="{StaticResource AccentButton}"
                                    Click="BtnCookieAdd_Click"/>
                            <TextBlock x:Name="CookieStatus" VerticalAlignment="Center" Margin="14,0,0,0"
                                       FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 浏览器导入 -->
                <Border Style="{StaticResource SurfaceCard}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="从内置浏览器导入" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="先进入「社区 / 视频」页并在米游社内登录，然后点击下方按钮，直接导入登录态。"
                                   FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,0"
                                   TextWrapping="Wrap" MaxWidth="520"/>
                        <Button x:Name="BtnImport" Content="从内置浏览器导入登录态" Margin="0,12,0,0"
                                Style="{StaticResource AccentButton}" Padding="16,8"
                                Click="BtnImport_Click"/>
                        <TextBlock x:Name="ImportStatus" Margin="0,10,0,0" FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
