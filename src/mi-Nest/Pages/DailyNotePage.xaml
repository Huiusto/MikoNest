<UserControl x:Class="MiNest.Pages.DailyNotePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="26,22,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 头部 -->
        <Grid Grid.Row="0">
            <TextBlock x:Name="PageTitle" Text="实时便笺" Style="{StaticResource PageTitleText}"
                       Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnRefresh" Content="刷新便笺" Style="{StaticResource AccentButton}"
                        Click="BtnRefresh_Click"/>
            </StackPanel>
        </Grid>

        <!-- 账号栏 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,0">
            <TextBlock Text="当前账号" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondary}" FontSize="13"/>
            <ComboBox x:Name="CmbAccount" Width="240" Margin="10,0,0,0" VerticalAlignment="Center"
                      DisplayMemberPath="DisplayName" SelectionChanged="CmbAccount_SelectionChanged"/>
            <TextBlock x:Name="TxtHint" VerticalAlignment="Center" Margin="14,0,0,0"
                       Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
        </StackPanel>

        <!-- 便笺卡片 -->
        <ScrollViewer Grid.Row="2" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="NoteList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="300" Margin="0,0,12,12" Padding="16,14"
                                Style="{StaticResource SurfaceCard}">
                            <StackPanel>
                                <!-- 游戏名 + 状态 -->
                                <Grid>
                                    <TextBlock Text="{Binding GameName}" FontSize="15" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Right"
                                               FontSize="12" Foreground="{Binding StatusBrush}"/>
                                </Grid>
                                <TextBlock Text="{Binding NicknameLine}" FontSize="11.5" Margin="0,3,0,0"
                                           Foreground="{DynamicResource TextSecondary}"/>

                                <!-- 体力进度 -->
                                <TextBlock Text="体力 / 电量" FontSize="11.5" Margin="0,12,0,3"
                                           Foreground="{DynamicResource TextSecondary}"/>
                                <Grid>
                                    <ProgressBar Minimum="0" Maximum="{Binding Max, Mode=OneWay}" Value="{Binding Current, Mode=OneWay}"
                                                 Height="14" Foreground="{Binding BarBrush}"
                                                 Background="{DynamicResource CardBorder}"
                                                 BorderThickness="0"/>
                                    <TextBlock Text="{Binding ResinText}" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                </Grid>
                                <TextBlock Text="{Binding RecoveryText}" FontSize="11.5" Margin="0,4,0,0"
                                           Foreground="{DynamicResource TextSecondary}"/>

                                <Border Height="1" Margin="0,10,0,10"
                                        Background="{DynamicResource CardBorder}"/>

                                <TextBlock Text="{Binding Extra}" FontSize="12" Margin="0,0,0,3"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="{Binding Extra2}" FontSize="12" Margin="0,0,0,3"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="{Binding ExpeditionText}" FontSize="12" Margin="0,0,0,3"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="{Binding DailyText}" FontSize="12"
                                           Foreground="{DynamicResource TextSecondary}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
