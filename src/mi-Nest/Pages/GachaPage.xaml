<UserControl x:Class="MiNest.Pages.GachaPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="26,20,26,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== 顶部：标题 + 账号/UID + 更新/更多/设置 ===== -->
        <StackPanel Grid.Row="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtTitle" Text="祈愿记录" FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <Button x:Name="BtnBeyond" Content="千星奇域颂愿" Visibility="Collapsed"
                                Height="28" Padding="12,0" Margin="14,3,0,0" FontSize="12"
                                VerticalAlignment="Center" Click="BtnBeyond_Click"
                                AutomationProperties.Name="千星奇域颂愿"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtSubtitle" Text="本地库 0 条"
                               FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="1,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <ComboBox x:Name="ComboGame" Width="104" Height="34" VerticalContentAlignment="Center"
                              Margin="0,3,8,0" SelectionChanged="ComboGame_SelectionChanged"/>
                    <ComboBox x:Name="ComboUid" Width="152" Height="34" VerticalContentAlignment="Center"
                              Margin="0,3,8,0" SelectionChanged="ComboUid_SelectionChanged"/>
                    <Button x:Name="BtnUpdate" Content="更新记录" Style="{StaticResource AccentButton}"
                            Height="34" Padding="18,0" Margin="0,3,0,0" Click="BtnUpdate_Click"/>
                    <Button x:Name="BtnMore" Content="▾" Height="34" Width="34" Padding="0"
                            Margin="6,3,0,0" Click="BtnMore_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="从游戏缓存重新读取" Click="MenuUpdateCache_Click"/>
                                <MenuItem Header="从登录账号获取 authkey" Click="MenuUpdateAccount_Click"/>
                                <MenuItem Header="粘贴抽卡记录链接" Click="MenuPasteUrl_Click"/>
                                <Separator/>
                                <MenuItem Header="选择游戏安装目录…" Click="MenuPickFolder_Click"/>
                                <MenuItem Header="导入 UIGF / SRGF 文件…" Click="MenuImport_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="BtnSettings" Content="设置" Height="34" Padding="14,0"
                            Margin="6,3,0,0" Click="BtnSettings_Click"/>
                </StackPanel>
            </Grid>

            <!-- ===== 设置面板（默认折叠） ===== -->
            <Border x:Name="PanelSettings" Visibility="Collapsed" Margin="0,12,0,0"
                    Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="1" CornerRadius="12" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="抽卡记录设置" FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock x:Name="TxtSettingsInfo" Text="数据目录：—"
                                   FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <TextBlock Text="说明：authkey 来自游戏缓存（游戏内打开一次「抽卡记录」页面后写入），约 24 小时失效；过期后重新在游戏内打开该页面即可再次更新。"
                                   FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <CheckBox x:Name="ChkShow4" Content="显示 4★ 记录" FontSize="12"
                                      Foreground="{DynamicResource TextPrimary}" Margin="0,0,18,0"
                                      Checked="ShowOption_Changed" Unchecked="ShowOption_Changed"/>
                            <CheckBox x:Name="ChkShowIcon" Content="显示条目图标" FontSize="12"
                                      Foreground="{DynamicResource TextPrimary}"
                                      Checked="ShowOption_Changed" Unchecked="ShowOption_Changed"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Content="导出 UIGF" Padding="12,6" Click="ExportUigf_Click"/>
                        <Button Content="导出 SRGF" Padding="12,6" Margin="6,0,0,0" Click="ExportSrgf_Click"/>
                        <Button Content="导出 CSV" Padding="12,6" Margin="6,0,0,0" Click="ExportCsv_Click"/>
                        <Button Content="打开数据目录" Padding="12,6" Margin="6,0,0,0" Click="OpenDataDir_Click"/>
                        <Button Content="清空当前 UID" Style="{StaticResource DangerButton}"
                                Padding="12,6" Margin="6,0,0,0" Click="ClearUid_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <!-- ===== 卡池分列（横向可滚动） ===== -->
        <ScrollViewer x:Name="BannerScroll" Grid.Row="1" Margin="0,16,0,0" SizeChanged="BannerScroll_SizeChanged"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="BannerPanel" Orientation="Horizontal" VerticalAlignment="Top"/>
        </ScrollViewer>

        <!-- ===== 千星奇域颂愿（两列） ===== -->
        <ScrollViewer x:Name="BeyondScroll" Grid.Row="1" Margin="0,16,0,0" Visibility="Collapsed"
                      SizeChanged="BeyondScroll_SizeChanged"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="BeyondPanel" Orientation="Horizontal" VerticalAlignment="Top"/>
        </ScrollViewer>

        <!-- ===== 底部状态 ===== -->
        <Border Grid.Row="2" Margin="0,10,0,0" Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                CornerRadius="10" Padding="14,8">
            <TextBlock x:Name="TxtStatus" Text="就绪"
                       FontSize="11.5" Foreground="{DynamicResource TextSecondary}"
                       TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</UserControl>
