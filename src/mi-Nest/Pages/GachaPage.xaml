<UserControl x:Class="MiNest.Pages.GachaPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="26,22,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== 操作区卡片：筛选 / 获取 / 本地库工具 一体分组 ===== -->
        <Border Grid.Row="0" Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                CornerRadius="12" Padding="16,14" Effect="{DynamicResource CardShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 行1：标题 + 筛选 + 主操作 -->
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="抽卡记录" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        <TextBlock Text="游戏" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                   VerticalAlignment="Center" Margin="20,0,0,0"/>
                        <ComboBox x:Name="ComboGame" Width="120" Margin="6,0,0,0" VerticalAlignment="Center"
                                  SelectionChanged="ComboGame_SelectionChanged"/>
                        <TextBlock Text="UID" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                        <ComboBox x:Name="ComboUid" Width="110" Margin="6,0,0,0" VerticalAlignment="Center"
                                  SelectionChanged="ComboUid_SelectionChanged"/>
                        <TextBlock Text="卡池" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                        <ComboBox x:Name="ComboPool" Width="90" Margin="6,0,0,0" VerticalAlignment="Center"
                                  SelectionChanged="ComboPool_SelectionChanged"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="自动获取" Style="{StaticResource AccentButton}" Padding="18,8"
                                Click="BtnAutoFetch_Click"/>
                        <Button x:Name="BtnFromAccount" Content="从登录账号获取" Padding="18,8" Margin="8,0,0,0"
                                Click="BtnFromAccount_Click"/>
                    </StackPanel>
                </Grid>

                <!-- 行2：获取方式（左）+ 本地库导入导出（右），细分隔线 -->
                <Border Grid.Row="1" Height="1" Background="{DynamicResource CardBorder}" Margin="0,12,0,0"/>
                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="获取方式" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                        <Button Content="选择游戏目录" Margin="10,0,0,0" Padding="12,6" Click="BtnPickFolder_Click"/>
                        <Button Content="粘贴链接" Margin="8,0,0,0" Padding="12,6" Click="BtnPasteUrl_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="本地库" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtLocalTotal" Text="0 条" FontSize="12.5" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        <Button Content="导入 UIGF/SRGF" Margin="16,0,0,0" Padding="12,6" Click="BtnImport_Click"/>
                        <Button Content="导出 UIGF" Margin="8,0,0,0" Padding="12,6" Click="BtnExportUigf_Click"/>
                        <Button Content="导出 SRGF" Margin="8,0,0,0" Padding="12,6" Click="BtnExportSrgf_Click"/>
                        <Button Content="导出 CSV" Margin="8,0,0,0" Padding="12,6" Click="BtnExportCsv_Click"/>
                        <Button Content="清空当前" Margin="8,0,0,0" Padding="12,6" Click="BtnClear_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ===== 统计卡片 ===== -->
        <WrapPanel x:Name="StatsPanel" Grid.Row="1" Margin="0,16,0,0"/>

        <!-- ===== 记录列表 ===== -->
        <Border Grid.Row="2" Margin="0,16,0,0" Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="14" Effect="{DynamicResource CardShadow}">
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" Background="Transparent" BorderThickness="0"
                      RowBackground="Transparent" Foreground="{DynamicResource TextPrimary}"
                      FontSize="12.5" GridLinesVisibility="None" CanUserSortColumns="True"
                      CanUserReorderColumns="False" CanUserAddRows="False" RowHeight="36"
                      VerticalScrollBarVisibility="Auto">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource ButtonBg}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Padding" Value="10,7"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource NavHoverBg}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="170"/>
                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="185"/>
                    <DataGridTextColumn Header="类型" Binding="{Binding ItemType}" Width="85"/>
                    <DataGridTemplateColumn Header="品质" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RankType, Converter={StaticResource RankStar}}"
                                           Foreground="{Binding RankType, Converter={StaticResource RankBrush}}"
                                           FontWeight="Bold" VerticalAlignment="Center" Margin="4,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="卡池" Binding="{Binding PoolName}" Width="145"/>
                    <DataGridTextColumn Header="UID" Binding="{Binding Uid}" Width="115"/>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="1" Visibility="Collapsed"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock x:Name="TxtStatus" Grid.Row="3" Margin="0,12,0,0"
                   Foreground="{DynamicResource TextSecondary}" FontSize="12.5" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
