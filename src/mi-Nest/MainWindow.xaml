<Window x:Class="MiNest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:svc="clr-namespace:MiNest.Services"
        Title="mi-Nest"
        Icon="Assets/logo.ico"
        Width="1300" Height="700" MinWidth="1000" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PageBg}"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="118"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= 胡桃风格背景（隐藏设置可开关） ================= -->
        <Image x:Name="BackdropImage" Grid.ColumnSpan="2" Stretch="UniformToFill"
               Visibility="Collapsed" IsHitTestVisible="False"
               RenderOptions.BitmapScalingMode="HighQuality"/>
        <Border x:Name="BackdropVeil" Grid.ColumnSpan="2" Visibility="Collapsed"
                IsHitTestVisible="False" Background="#4DFFF6F2"/>

        <!-- ================= 左侧导航栏（毛玻璃感） ================= -->
        <Border x:Name="SidebarBorder" Grid.Column="0" Background="{DynamicResource SidebarBg}"
                BorderBrush="{DynamicResource NavBorder}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo + 名称 -->
                <StackPanel Grid.Row="0" Margin="0,22,0,14" HorizontalAlignment="Center">
                    <Border Width="54" Height="54" CornerRadius="14"
                            Background="{DynamicResource CardBg}"
                            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                            Effect="{DynamicResource CardShadow}">
                        <Image x:Name="LogoImage" Source="Assets/logo.png" Width="44" Height="44"
                               Margin="5" Stretch="Uniform"/>
                    </Border>
                    <TextBlock Text="mi-Nest" FontSize="13.5" FontWeight="Bold"
                               Foreground="{DynamicResource SidebarFg}"
                               HorizontalAlignment="Center" Margin="0,9,0,0"/>
                </StackPanel>

                <!-- 网页：向后 / 向前 / 刷新（胶囊按钮组） -->
                <Border Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,12"
                        Background="{DynamicResource NavHoverBg}" CornerRadius="11" Padding="5,4">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnBack" Width="30" Height="30" Padding="0" FontFamily="Segoe MDL2 Assets"
                                FontSize="12.5" Content="&#xE72B;" ToolTip="后退" Click="BtnBack_Click" IsEnabled="False"/>
                        <Button x:Name="BtnForward" Width="30" Height="30" Padding="0" Margin="4,0,0,0"
                                FontFamily="Segoe MDL2 Assets" FontSize="12.5" Content="&#xE72A;"
                                ToolTip="向前" Click="BtnForward_Click" IsEnabled="False"/>
                        <Button x:Name="BtnRefresh" Width="30" Height="30" Padding="0" Margin="4,0,0,0"
                                FontFamily="Segoe MDL2 Assets" FontSize="12.5" Content="&#xE72C;"
                                ToolTip="刷新" Click="BtnRefresh_Click" IsEnabled="False"/>
                    </StackPanel>
                </Border>

                <!-- 中间导航项（固定排布，不做上下滑动；顺序可在 设置-管理项目栏 调整） -->
                <StackPanel x:Name="NavMiddlePanel" Grid.Row="2" VerticalAlignment="Top" ClipToBounds="True"
                            Margin="0,0,0,0"/>

                <!-- 底部：账号 / 设置 -->
                <StackPanel Grid.Row="3" Margin="0,0,0,16">
                    <RadioButton x:Name="NavAccount" Style="{StaticResource SidebarNavItem}" GroupName="nav"
                                 Content="&#xE77B;" Tag="账号" Checked="Nav_Checked"
                                 svc:LocalizationService.Key="nav_account"
                                 AutomationProperties.Name="账号"/>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource SidebarNavItem}" GroupName="nav"
                                 Content="&#xE713;" Tag="设置" Checked="Nav_Checked"
                                 svc:LocalizationService.Key="nav_settings"
                                 AutomationProperties.Name="设置"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 内容区 ================= -->
        <Grid Grid.Column="1">
            <ContentControl x:Name="PageHost"/>

            <!-- WebView2 宿主（社区 / 视频 / 站内网页共用，登录态持久化） -->
            <Grid x:Name="WebHost" Visibility="Collapsed">
                <wv2:WebView2 x:Name="WebView"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
