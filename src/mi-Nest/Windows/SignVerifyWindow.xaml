<Window x:Class="MiNest.Windows.SignVerifyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="安全验证 · MikoNest"
        Width="980" Height="780"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource PageBg}"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- 标题区 -->
        <Border Grid.Row="0" Padding="22,16,22,14"
                Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="TxtTitle" Text="安全验证" FontSize="17" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock x:Name="TxtHint"
                               Text="米哈游检测到本次操作需要人机验证。请在下方的官方页面完成验证并点击「签到」，完成后关闭本窗口。"
                               FontSize="11.5" TextWrapping="Wrap" MaxWidth="720" Margin="0,5,0,0"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
                <Border Grid.Column="1" VerticalAlignment="Top" CornerRadius="10"
                        Padding="10,5" Background="{DynamicResource AccentSoft}">
                    <TextBlock x:Name="TxtAccount" Text="当前账号" FontSize="11"
                               Foreground="{DynamicResource Accent}"/>
                </Border>
            </Grid>
        </Border>

        <!-- 官方验证页面 -->
        <Border Grid.Row="1" Margin="16,14,16,10" CornerRadius="14" ClipToBounds="True"
                Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
            <Grid>
                <wv2:WebView2 x:Name="Web"/>
                <Border x:Name="LoadingMask" Background="{DynamicResource CardBg}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="正在打开官方验证页面…" FontSize="13"
                                   Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtLoadingHint" Text="首次打开可能需要几秒" Margin="0,10,0,0"
                                   FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 底部操作 -->
        <Grid Grid.Row="2" Margin="18,0,18,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TxtFooter" VerticalAlignment="Center" FontSize="11"
                       TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"
                       Text="验证完成后回到本窗口点「我已完成验证」，软件会自动重试签到。"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="取消"  Height="34" Margin="0,0,8,0"
                        Padding="18,0" Click="BtnCancel_Click"/>
                <Button Content="我已完成验证" Style="{StaticResource AccentButton}" Height="34"
                        Padding="22,0" Click="BtnDone_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>


