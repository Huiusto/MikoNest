<Window x:Class="MiNest.Windows.InstallGameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="安装游戏"
        Width="780" Height="520"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Padding" Value="26,0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#5A5148"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="9" Background="#FFFFFF"
                                BorderBrush="#D8D1C7" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F5F1EA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Padding" Value="34,0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="9" Background="#C0392B"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#A93226"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LangRb" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,26,0"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="#5A5148"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12" Background="#FAF8F5" BorderBrush="#E3DCD2" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="78"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="#F2EDE4" CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="18,0,10,0">
                    <TextBlock x:Name="TxtTitle" Text="选择安装路径" FontSize="16" FontWeight="SemiBold"
                               Foreground="#3F3931" VerticalAlignment="Center"/>
                    <Button Content="✕" Width="44" Height="34" HorizontalAlignment="Right"
                            Background="Transparent" BorderThickness="0" FontSize="15"
                            Foreground="#7A7166" Cursor="Hand" Click="BtnClose_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" CornerRadius="9" Background="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="#E8E0D4"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- 内容 -->
            <StackPanel Grid.Row="1" Margin="26,20,26,0">
                <TextBlock x:Name="TxtGameInfo" Text="原神" FontSize="14" FontWeight="SemiBold"
                           Foreground="#3F3931"/>
                <TextBlock x:Name="TxtTip" Text="将安装到本机，下载与解压由米哈游官方启动器完成。"
                           FontSize="12" Foreground="#8A8178" Margin="0,6,0,0" TextWrapping="Wrap"/>

                <TextBlock Text="安装路径" FontSize="13" Foreground="#8A8178" Margin="0,18,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#FFFFFF" BorderBrush="#D8D1C7" BorderThickness="1" CornerRadius="6"
                            Height="38">
                        <TextBlock x:Name="TxtPath" Text="" FontSize="12.5" Foreground="#5A5148"
                                   VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis"/>
                    </Border>
                    <Button Grid.Column="1" x:Name="BtnBrowse" Content="更改" Style="{StaticResource GhostBtn}"
                            Height="38" Margin="10,0,0,0" Padding="24,0" MinWidth="80" Click="BtnBrowse_Click"/>
                </Grid>
                <CheckBox x:Name="ChkSubFolder" Content="自动创建子文件夹" IsChecked="True"
                          FontSize="12.5" Foreground="#5A5148" Margin="0,10,0,0"
                          Checked="ChkSubFolder_Changed" Unchecked="ChkSubFolder_Changed"/>

                <TextBlock x:Name="TxtHardLink" Text="支持硬链接：已安装其它米哈游游戏时可共用文件，节省磁盘空间。"
                           FontSize="12" Foreground="#8A8178" Margin="0,14,0,0" TextWrapping="Wrap"/>

                <TextBlock Text="游戏语言" FontSize="13" Foreground="#8A8178" Margin="0,16,0,6"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="RdoZh" Style="{StaticResource LangRb}" Content="汉语" GroupName="lang" IsChecked="True"/>
                    <RadioButton x:Name="RdoEn" Style="{StaticResource LangRb}" Content="英语" GroupName="lang"/>
                    <RadioButton x:Name="RdoJa" Style="{StaticResource LangRb}" Content="日语" GroupName="lang"/>
                    <RadioButton x:Name="RdoKo" Style="{StaticResource LangRb}" Content="韩语" GroupName="lang"/>
                </StackPanel>

                <TextBlock x:Name="TxtSpace" Text="" FontSize="12.5" Foreground="#5A5148" Margin="0,16,0,0"/>
            </StackPanel>

            <!-- 底部按钮 -->
            <Grid Grid.Row="2" Margin="26,0,26,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="取消" Style="{StaticResource GhostBtn}" MinWidth="104" Click="BtnCancel_Click"/>
                    <Button x:Name="BtnInstall" Content="开始安装" Style="{StaticResource PrimaryBtn}"
                            MinWidth="132" Margin="14,0,0,0" Click="BtnInstall_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
