<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>mi-Nest</AssemblyName>
    <RootNamespace>MiNest</RootNamespace>
    <Version>0.1.12</Version>
    <Authors>mi-Nest Contributors</Authors>
    <Product>mi-Nest</Product>
    <Description>mi-Nest - 米哈游 PC 多功能桌面客户端（开源）</Description>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\**\*" />
  </ItemGroup>

  <Target Name="ApplyIconToExe" AfterTargets="Build">
    <Exec Command="&quot;$(MSBuildProjectDirectory)\..\..\tools\rcedit-x64.exe&quot; &quot;$(TargetPath)&quot; --set-icon &quot;$(MSBuildProjectDirectory)\Assets\logo.ico&quot;" ContinueOnError="true" />
  </Target>

</Project>
