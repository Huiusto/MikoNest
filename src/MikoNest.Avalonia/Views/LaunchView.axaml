<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MiNest.Avalonia.Views.LaunchView">

  <Grid RowDefinitions="Auto,*,Auto" ClipToBounds="True">

    <!-- 背景层：官方版本壁纸 / 自定义壁纸 -->
    <Image x:Name="Backdrop" Grid.RowSpan="3" Stretch="UniformToFill"
           HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
    <Border Grid.RowSpan="3" IsHitTestVisible="False">
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,55%" EndPoint="0%,100%">
          <GradientStop Color="#00000000" Offset="0"/>
          <GradientStop Color="#26000000" Offset="0.55"/>
          <GradientStop Color="#8C000000" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
    </Border>

    <!-- 顶部：游戏切换 -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="24,20,24,0">
      <Border CornerRadius="14" Padding="12,8" HorizontalAlignment="Left" VerticalAlignment="Top"
              Background="#400B1020" BorderBrush="#2EFFFFFF" BorderThickness="1"
              BoxShadow="0 8 22 0 #33000000">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Border Width="26" Height="26" CornerRadius="9" Background="Transparent"
                  VerticalAlignment="Center">
            <Image Source="/Assets/logo.png" Width="26" Height="26" Stretch="Uniform"/>
          </Border>
          <StackPanel Spacing="1" VerticalAlignment="Center">
            <TextBlock Text="MikoNest" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFFFF"/>
            <TextBlock x:Name="TxtSync" Text="正在同步官方壁纸…" FontSize="10" Foreground="#CCFFFFFF"/>
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Grid.Column="1" CornerRadius="16" Padding="4"
              Background="#400B1020" BorderBrush="#3DFFFFFF" BorderThickness="1"
              BoxShadow="0 8 22 0 #33000000">
        <StackPanel x:Name="GameChips" Orientation="Horizontal" Spacing="2"/>
      </Border>
    </Grid>

    <!-- 中部：壁纸切换圆点（靠左固定尺寸，不随静态/动态改变大小） -->
    <Border Grid.Row="1" Width="40" CornerRadius="20" Padding="0,10"
            HorizontalAlignment="Left" VerticalAlignment="Center" Margin="24,0,0,0"
            Background="#23000000" BorderBrush="#2EFFFFFF" BorderThickness="1">
      <StackPanel x:Name="DotPanel" Spacing="6" VerticalAlignment="Center"/>
    </Border>

    <!-- 底部：游戏信息 + 操作 -->
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="26,0,26,24">
      <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" CornerRadius="18" Padding="20,16,26,16"
              Background="#4D0B1020" BorderBrush="#33FFFFFF" BorderThickness="1">
        <StackPanel Spacing="7">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Width="3" Height="26" CornerRadius="2" Background="{DynamicResource AccentGradient}"
                    VerticalAlignment="Center"/>
            <TextBlock x:Name="TxtGameName" Text="原神" FontSize="32" FontWeight="Bold"
                       Foreground="#FFFFFFFF" LetterSpacing="0.4"/>
          </StackPanel>
          <TextBlock x:Name="TxtGameSub" Text="Genshin Impact · 官方最新版本壁纸" FontSize="12"
                     Foreground="#D9FFFFFF"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border CornerRadius="8" Background="#26FFFFFF" Padding="8,3">
              <TextBlock x:Name="TxtVersion" Text="版本 0.1.28 · macOS / Windows" FontSize="10"
                         Foreground="#E6FFFFFF"/>
            </Border>
            <Border CornerRadius="8" Background="#26000000" Padding="8,3">
              <TextBlock Text="官方壁纸自动同步" FontSize="10" Foreground="#B3FFFFFF"/>
            </Border>
          </StackPanel>
        </StackPanel>
      </Border>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom">
        <Button x:Name="BtnGet" Height="46" Padding="20,0" CornerRadius="14"
                FontSize="13" Content="安装游戏" Click="BtnGet_Click">
          <Button.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
              <GradientStop Color="#33FFFFFF" Offset="0"/>
              <GradientStop Color="#1AFFFFFF" Offset="1"/>
            </LinearGradientBrush>
          </Button.Background>
          <Button.Foreground>
            <SolidColorBrush Color="#FFFFFFFF"/>
          </Button.Foreground>
        </Button>
        <Button x:Name="BtnPlay" Classes="primary" Height="46" Padding="30,0" CornerRadius="14"
                FontSize="14.5" Content="开始游戏" Click="BtnPlay_Click"/>
        <Button x:Name="BtnGameSettings" Height="46" Width="46" Padding="0" CornerRadius="14"
                FontSize="20" Content="☰" ToolTip.Tip="游戏设置" Click="BtnGameSettings_Click">
          <Button.Background>
            <SolidColorBrush Color="#3D0B1020"/>
          </Button.Background>
          <Button.Foreground>
            <SolidColorBrush Color="#FFFFFFFF"/>
          </Button.Foreground>
        </Button>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>

