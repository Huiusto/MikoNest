<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MiNest.Avalonia.MainWindow"
        Title="mi-Nest"
        Width="1360" Height="860"
        MinWidth="1080" MinHeight="700"
        Background="{DynamicResource PageBgFlat}"
        TransparencyLevelHint="Mica, AcrylicBlur"
        ExtendClientAreaToDecorationsHint="False">

  <Grid ColumnDefinitions="auto,*">
    <!-- ================= 侧栏 ================= -->
    <Border x:Name="Sidebar" Grid.Column="0" Width="212"
            Background="{DynamicResource SidebarBg}"
            BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto" Margin="10,14,10,14">
        <!-- 品牌 + 折叠 -->
        <Button x:Name="BtnBrand" Grid.Row="0" Background="Transparent" BorderThickness="0"
                Padding="6" Cursor="Hand" HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left" ToolTip.Tip="点击折叠 / 展开侧栏">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource AccentSoft}">
              <TextBlock Text="M" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource AccentText}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel x:Name="BrandText" VerticalAlignment="Center">
              <TextBlock Text="mi-Nest" FontSize="15" FontWeight="SemiBold"/>
              <TextBlock Text="MIHOYO LAUNCHER" FontSize="8.5" Classes="muted" LetterSpacing="0.9"/>
            </StackPanel>
          </StackPanel>
        </Button>

        <!-- 导航 -->
        <ScrollViewer Grid.Row="1" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="NavPanel" Spacing="4"/>
        </ScrollViewer>

        <!-- 账号 / 设置 -->
        <StackPanel Grid.Row="2" Spacing="4">
          <Border Height="1" Background="{DynamicResource Divider}" Margin="6,0,6,8"/>
          <Button x:Name="BtnAccount" Classes="nav" Click="NavAccount_Click">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="☺" FontSize="14"/>
              <TextBlock x:Name="LblAccount" Text="账号" FontSize="12.5" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="BtnSettings" Classes="nav" Click="NavSettings_Click">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="⚙" FontSize="14"/>
              <TextBlock x:Name="LblSettings" Text="设置" FontSize="12.5" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ================= 内容区 ================= -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*">
      <!-- 顶部标题栏 -->
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="26,20,26,6">
        <StackPanel Spacing="4">
          <TextBlock x:Name="PageTitle" Text="启动" Classes="h1"/>
          <TextBlock x:Name="PageSubtitle" Classes="muted" FontSize="12"
                     Text="同步官方版本壁纸 · 预下载 · 一键启动"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
          <Border Classes="card" Padding="12,7" CornerRadius="12">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Ellipse Width="7" Height="7" Fill="{DynamicResource Accent}" VerticalAlignment="Center"/>
              <TextBlock x:Name="TxtAccount" FontSize="11.5" Classes="muted" Text="未登录"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>

      <!-- 页面容器 -->
      <Border Grid.Row="1" Margin="18,6,18,18" CornerRadius="18" ClipToBounds="True">
        <Grid>
          <Border Background="{DynamicResource PageBg}"/>
          <!-- 右上角柔光 -->
          <Ellipse Width="520" Height="520" HorizontalAlignment="Right" VerticalAlignment="Top"
                   Margin="0,-260,-180,0" Fill="{DynamicResource AccentSoft}" Opacity="0.55"
                   IsHitTestVisible="False"/>
          <ContentControl x:Name="PageHost"/>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
