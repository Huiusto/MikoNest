<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MiNest.Avalonia.Views.LaunchView">

  <Grid RowDefinitions="Auto,*,Auto" ClipToBounds="True">

    <!-- 背景层：官方版本壁纸 / 自定义壁纸 -->
    <Image x:Name="Backdrop" Grid.RowSpan="3" Stretch="UniformToFill"
           HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
    <Border Grid.RowSpan="3" IsHitTestVisible="False">
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,55%" EndPoint="0%,100%">
          <GradientStop Color="#00000000" Offset="0"/>
          <GradientStop Color="#26000000" Offset="0.55"/>
          <GradientStop Color="#8C000000" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
    </Border>

    <!-- 顶部：游戏切换 -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="24,20,24,0">
      <Border CornerRadius="12" Padding="10,6" HorizontalAlignment="Left" VerticalAlignment="Top"
              Background="#33000000" BorderBrush="#26FFFFFF" BorderThickness="1">
        <StackPanel Spacing="1">
          <TextBlock Text="mi-Nest" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
          <TextBlock x:Name="TxtSync" Text="正在同步官方壁纸…" FontSize="10" Foreground="#CCFFFFFF"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="1" CornerRadius="14" Padding="4"
              Background="#40000000" BorderBrush="#3DFFFFFF" BorderThickness="1">
        <StackPanel x:Name="GameChips" Orientation="Horizontal" Spacing="2"/>
      </Border>
    </Grid>

    <!-- 中部：壁纸切换圆点（靠左固定尺寸，不随静态/动态改变大小） -->
    <Border Grid.Row="1" Width="40" CornerRadius="20" Padding="0,10"
            HorizontalAlignment="Left" VerticalAlignment="Center" Margin="24,0,0,0"
            Background="#23000000" BorderBrush="#2EFFFFFF" BorderThickness="1">
      <StackPanel x:Name="DotPanel" Spacing="6" VerticalAlignment="Center"/>
    </Border>

    <!-- 底部：游戏信息 + 操作 -->
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="28,0,28,26">
      <StackPanel VerticalAlignment="Bottom" Spacing="6">
        <TextBlock x:Name="TxtGameName" Text="原神" FontSize="34" FontWeight="Bold" Foreground="#FFFFFF"/>
        <TextBlock x:Name="TxtGameSub" Text="Genshin Impact · 官方最新版本壁纸" FontSize="12"
                   Foreground="#CCFFFFFF"/>
        <TextBlock x:Name="TxtVersion" Text="版本 0.1.13 · macOS / Windows" FontSize="10.5"
                   Foreground="#99FFFFFF"/>
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom">
        <Button x:Name="BtnGet" Classes="ghost" Height="44" Padding="18,0" CornerRadius="12"
                Content="获取游戏" Click="BtnGet_Click"/>
        <Button x:Name="BtnPlay" Classes="primary" Height="44" Padding="26,0" CornerRadius="12"
                FontSize="14" Content="开始游戏" Click="BtnPlay_Click"/>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
