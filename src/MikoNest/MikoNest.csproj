<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>MikoNest</AssemblyName>
    <RootNamespace>MiNest</RootNamespace>
    <Version>0.1.39</Version>
    <Authors>MikoNest Contributors</Authors>
    <Product>MikoNest</Product>
    <Description>MikoNest - 米哈游 PC 多功能桌面客户端（开源）</Description>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.6" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\**\*" />
  </ItemGroup>

  <Target Name="ApplyIconToExe" AfterTargets="Build">
    <Exec Command="&quot;$(MSBuildProjectDirectory)\..\..\tools\rcedit-x64.exe&quot; &quot;$(TargetPath)&quot; --set-icon &quot;$(MSBuildProjectDirectory)\Assets\logo.ico&quot;" ContinueOnError="true" />
  </Target>

</Project>


