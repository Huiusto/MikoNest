<Window x:Class="MiNest.Pages.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入" Width="560" Height="220" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False" Background="{DynamicResource PageBg}"
        FontFamily="Microsoft YaHei UI">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="Prompt" Grid.Row="0" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextPrimary}" FontSize="13"/>
        <TextBox x:Name="InputBox" Grid.Row="1" Margin="0,14,0,0" VerticalAlignment="Top"
                 Style="{StaticResource MultilineTextBox}" MinHeight="66" FontSize="12.5"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Width="88" Click="Cancel_Click"/>
            <Button Content="确定" Width="88" Margin="10,0,0,0" Style="{StaticResource AccentButton}"
                    Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
