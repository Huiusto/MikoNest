<UserControl x:Class="MiNest.Pages.TaskPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SizeChanged="TaskPage_SizeChanged">
    <Grid x:Name="RootGrid" Margin="26,20,26,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶栏：标题 + 全局操作 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource TitleAccentBar}"/>
                <TextBlock Text="任务 / 签到" Style="{StaticResource PageTitleText}" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtSubTitle" Text="米游币每日任务 · 角色签到 · 多账号一键执行" FontSize="12"
                           Foreground="{DynamicResource TextSecondary}" Margin="12,2,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="BtnRefreshAll" Content="刷新" Padding="12,5" FontSize="12" Click="BtnRefreshAll_Click"/>
                <Button x:Name="BtnCheckInTest" Content="打卡测试" Padding="12,5" FontSize="12" Margin="6,0,0,0"
                        Click="BtnCheckInTest_Click"/>
                <Button x:Name="BtnRunCurrent" Content="一键执行当前账号" Padding="12,5" FontSize="12" Margin="6,0,0,0"
                        Style="{StaticResource AccentButton}" Click="BtnRunCurrent_Click"/>
                <Button x:Name="BtnRunAll" Content="一键执行全部账号" Padding="12,5" FontSize="12" Margin="6,0,0,0"
                        Style="{StaticResource AccentButton}" Click="BtnRunAll_Click"/>
            </StackPanel>
        </Grid>

        <!-- 账号条 -->
        <Border Grid.Row="1" Margin="0,14,0,0" Style="{StaticResource SurfaceCard}" Padding="16,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="当前账号" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CmbAccount" Width="260" Height="32" Margin="12,0,0,0"
                                  VerticalAlignment="Center" VerticalContentAlignment="Center"
                                  DisplayMemberPath="DisplayName" SelectionChanged="CmbAccount_SelectionChanged"/>
                        <TextBlock x:Name="TxtUid" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,0,6,0"
                                 VerticalAlignment="Center" Fill="{DynamicResource TextSecondary}"/>
                        <TextBlock x:Name="TxtAccountStatus" VerticalAlignment="Center"
                                   FontSize="12.5" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
                <Border x:Name="BannerStoken" Grid.Row="1" Margin="0,8,0,0"
                        Background="{DynamicResource AccentSoft}" CornerRadius="8" Padding="10,7"
                        Visibility="Collapsed">
                    <TextBlock x:Name="TxtAccountHint" FontSize="12" Foreground="{DynamicResource TextPrimary}"
                               TextWrapping="Wrap"/>
                </Border>
            </Grid>
        </Border>

        <!-- 主体：宽窗口左右两栏，窄窗口自动上下堆叠 -->
        <Grid x:Name="BodyGrid" Grid.Row="2" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="BodyRow1" Height="*"/>
                <RowDefinition x:Name="BodyRow2" Height="0"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="BodyCol1" Width="*"/>
                <ColumnDefinition x:Name="BodyColGap" Width="14"/>
                <ColumnDefinition x:Name="BodyCol2" Width="1.02*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Row="0" Grid.Column="0" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- 米游币任务 -->
                    <Border Style="{StaticResource SurfaceCard}" Padding="16,14">
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtMissionTitle" Text="米游币任务（0/0）" FontSize="15"
                                               FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="米游币" FontSize="11.5" Margin="8,1,0,0"
                                               Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="BtnRefreshMission" Content="刷新" Padding="12,4" FontSize="12"
                                            Click="BtnRefreshMission_Click"/>
                                    <Button x:Name="BtnRunMission" Content="执行" Padding="14,4" FontSize="12"
                                            Margin="8,0,0,0" Click="BtnRunMission_Click"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="TxtCoin" Text="持有米游币：0" FontSize="12.5" Margin="0,8,0,0"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <StackPanel x:Name="MissionPanel" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 签到任务 -->
                    <Border Margin="0,14,0,0" Style="{StaticResource SurfaceCard}" Padding="16,14">
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="签到任务" FontSize="15" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtSignCount" FontSize="11.5" Margin="8,1,0,0"
                                               Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="BtnRefreshSign" Content="刷新" Padding="12,4" FontSize="12"
                                            Click="BtnRefreshSign_Click"/>
                                    <Button x:Name="BtnRunSign" Content="执行" Padding="14,4" FontSize="12"
                                            Margin="8,0,0,0" Click="BtnRunSign_Click"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel x:Name="SignPanel" Margin="0,8,0,0"/>
                            <TextBlock x:Name="TxtSignTip" FontSize="11.5" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Text="勾选要签到的角色后点「执行」；点击整个条目也可以切换勾选。"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 输出日志 -->
            <Border x:Name="LogCard" Grid.Column="2" Style="{StaticResource SurfaceCard}" Padding="4" MinWidth="320">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="12,10,10,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="输出日志" FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtLogCount" FontSize="11.5" Margin="8,1,0,0"
                                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Content="清空" FontSize="11.5" Padding="12,4" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Click="BtnClearLog_Click"/>
                    </Grid>
                    <ListBox x:Name="LogList" Grid.Row="1" Margin="6,0,6,8" BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Line}" FontSize="12" TextWrapping="Wrap"
                                           FontFamily="Consolas, Microsoft YaHei UI">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Level}" Value="WARN">
                                                    <Setter Property="Foreground" Value="{DynamicResource Warning}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="ERROR">
                                                    <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
