<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 星穹铁道金 -->
    <SolidColorBrush x:Key="SidebarBg" Color="#E62E2414"/>
    <SolidColorBrush x:Key="SidebarFg" Color="#F5E7C8"/>
    <SolidColorBrush x:Key="SidebarDim" Color="#A89060"/>
    <SolidColorBrush x:Key="NavHoverBg" Color="#4D3B2E1B"/>
    <SolidColorBrush x:Key="NavActiveBg" Color="#D8B36A"/>
    <SolidColorBrush x:Key="NavActiveFg" Color="#2E2414"/>
    <SolidColorBrush x:Key="NavBorder" Color="#2E2414"/>

    <!-- 页面背景（苹果式渐变） -->
    <LinearGradientBrush x:Key="PageBg" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FBF7EE" Offset="0"/>
        <GradientStop Color="#E2DED6" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBorder" Color="#1A000000"/>
    <SolidColorBrush x:Key="InputBg" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="TextPrimary" Color="#2A2418"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#8A7A5C"/>
    <SolidColorBrush x:Key="TextOnAccent" Color="#2E2414"/>

    <SolidColorBrush x:Key="Accent" Color="#B98A2F"/>
    <SolidColorBrush x:Key="AccentHover" Color="#96701F"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#F4E8CD"/>

    <SolidColorBrush x:Key="ButtonBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ButtonBgHover" Color="#F6EFDF"/>
    <SolidColorBrush x:Key="ButtonFg" Color="#6B5416"/>
    <SolidColorBrush x:Key="ButtonBorder" Color="#33000000"/>

    <SolidColorBrush x:Key="Danger" Color="#D64045"/>
    <SolidColorBrush x:Key="Success" Color="#4C9A2A"/>
    <SolidColorBrush x:Key="Warning" Color="#E8B30C"/>

    <DropShadowEffect x:Key="CardShadow" BlurRadius="24" ShadowDepth="0" Direction="270" Opacity="0.14" Color="#000000"/>
</ResourceDictionary>
