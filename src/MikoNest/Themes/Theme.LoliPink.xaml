<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 萝莉粉：奶油粉 + 樱粉强调，明亮轻盈 -->
    <SolidColorBrush x:Key="SidebarBg" Color="#F2F9F4F8"/>
    <SolidColorBrush x:Key="SidebarFg" Color="#3A2230"/>
    <SolidColorBrush x:Key="SidebarDim" Color="#A0839A"/>
    <SolidColorBrush x:Key="NavHoverBg" Color="#55F3D9E9"/>
    <SolidColorBrush x:Key="NavActiveBg" Color="#3FE86A9A"/>
    <SolidColorBrush x:Key="NavActiveFg" Color="#D4588A"/>
    <SolidColorBrush x:Key="NavBorder" Color="#1AE0B7C9"/>

    <!-- 页面背景（樱粉雾面） -->
    <LinearGradientBrush x:Key="PageBg" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFF8FB" Offset="0"/>
        <GradientStop Color="#FDEDF4" Offset="0.45"/>
        <GradientStop Color="#F7E3EE" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBorder" Color="#14000000"/>
    <SolidColorBrush x:Key="InputBg" Color="#FFF4F8"/>

    <SolidColorBrush x:Key="TextPrimary" Color="#3A2230"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#96768B"/>
    <SolidColorBrush x:Key="TextOnAccent" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="Accent" Color="#E86A9A"/>
    <SolidColorBrush x:Key="AccentHover" Color="#D2537F"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#FBE0EC"/>

    <SolidColorBrush x:Key="ButtonBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ButtonBgHover" Color="#FDEEF4"/>
    <SolidColorBrush x:Key="ButtonFg" Color="#B84D77"/>
    <SolidColorBrush x:Key="ButtonBorder" Color="#33000000"/>

    <SolidColorBrush x:Key="Danger" Color="#E5484D"/>
    <SolidColorBrush x:Key="Success" Color="#30A46C"/>
    <SolidColorBrush x:Key="Warning" Color="#FFB224"/>

    <DropShadowEffect x:Key="CardShadow" BlurRadius="24" ShadowDepth="0" Direction="270" Opacity="0.14" Color="#000000"/>
</ResourceDictionary>
