<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 崩2橙：崩坏学园2 暖橙配色 -->
    <SolidColorBrush x:Key="SidebarBg" Color="#E6E8732B"/>
    <SolidColorBrush x:Key="SidebarFg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SidebarDim" Color="#FFE3CF"/>
    <SolidColorBrush x:Key="NavHoverBg" Color="#4DF08C3E"/>
    <SolidColorBrush x:Key="NavActiveBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="NavActiveFg" Color="#E8732B"/>
    <SolidColorBrush x:Key="NavBorder" Color="#E8732B"/>

    <!-- 页面背景（苹果式渐变） -->
    <LinearGradientBrush x:Key="PageBg" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FDF2E9" Offset="0"/>
        <GradientStop Color="#E4DAD2" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBorder" Color="#1A000000"/>
    <SolidColorBrush x:Key="InputBg" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="TextPrimary" Color="#2E2017"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#8A6B52"/>
    <SolidColorBrush x:Key="TextOnAccent" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="Accent" Color="#E8732B"/>
    <SolidColorBrush x:Key="AccentHover" Color="#C85E1F"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#FDE8D7"/>

    <SolidColorBrush x:Key="ButtonBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ButtonBgHover" Color="#FFF3E8"/>
    <SolidColorBrush x:Key="ButtonFg" Color="#E8732B"/>
    <SolidColorBrush x:Key="ButtonBorder" Color="#33000000"/>

    <SolidColorBrush x:Key="Danger" Color="#E5484D"/>
    <SolidColorBrush x:Key="Success" Color="#30A46C"/>
    <SolidColorBrush x:Key="Warning" Color="#FFB224"/>

    <DropShadowEffect x:Key="CardShadow" BlurRadius="24" ShadowDepth="0" Direction="270" Opacity="0.14" Color="#000000"/>
</ResourceDictionary>
