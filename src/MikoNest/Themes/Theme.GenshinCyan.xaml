<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 原神青 -->
    <SolidColorBrush x:Key="SidebarBg" Color="#E60F766E"/>
    <SolidColorBrush x:Key="SidebarFg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SidebarDim" Color="#B7E5E0"/>
    <SolidColorBrush x:Key="NavHoverBg" Color="#4D11877C"/>
    <SolidColorBrush x:Key="NavActiveBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="NavActiveFg" Color="#0F766E"/>
    <SolidColorBrush x:Key="NavBorder" Color="#0F766E"/>

    <!-- 页面背景（苹果式渐变） -->
    <LinearGradientBrush x:Key="PageBg" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#EFFAF8" Offset="0"/>
        <GradientStop Color="#D7E1DF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBorder" Color="#1A000000"/>
    <SolidColorBrush x:Key="InputBg" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="TextPrimary" Color="#14302C"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#4C7A73"/>
    <SolidColorBrush x:Key="TextOnAccent" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="Accent" Color="#0F9E8E"/>
    <SolidColorBrush x:Key="AccentHover" Color="#0C8174"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#DBF3EF"/>

    <SolidColorBrush x:Key="ButtonBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ButtonBgHover" Color="#EAF7F4"/>
    <SolidColorBrush x:Key="ButtonFg" Color="#0F766E"/>
    <SolidColorBrush x:Key="ButtonBorder" Color="#33000000"/>

    <SolidColorBrush x:Key="Danger" Color="#E5484D"/>
    <SolidColorBrush x:Key="Success" Color="#30A46C"/>
    <SolidColorBrush x:Key="Warning" Color="#FFB224"/>

    <DropShadowEffect x:Key="CardShadow" BlurRadius="24" ShadowDepth="0" Direction="270" Opacity="0.14" Color="#000000"/>
</ResourceDictionary>
