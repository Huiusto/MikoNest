<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 米哈游蓝：彩色侧边栏 -->
    <SolidColorBrush x:Key="SidebarBg" Color="#E61F65FF"/>
    <SolidColorBrush x:Key="SidebarFg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SidebarDim" Color="#D6E4FF"/>
    <SolidColorBrush x:Key="NavHoverBg" Color="#4D2A6EFF"/>
    <SolidColorBrush x:Key="NavActiveBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="NavActiveFg" Color="#1F65FF"/>
    <SolidColorBrush x:Key="NavBorder" Color="#1F65FF"/>

    <!-- 页面背景（苹果式渐变） -->
    <LinearGradientBrush x:Key="PageBg" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#EEF3FF" Offset="0"/>
        <GradientStop Color="#D6DBE6" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBorder" Color="#1A000000"/>
    <SolidColorBrush x:Key="InputBg" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="TextPrimary" Color="#1A2333"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#5C6B8C"/>
    <SolidColorBrush x:Key="TextOnAccent" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="Accent" Color="#1F65FF"/>
    <SolidColorBrush x:Key="AccentHover" Color="#1652CC"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#E4EDFF"/>

    <SolidColorBrush x:Key="ButtonBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ButtonBgHover" Color="#F0F5FF"/>
    <SolidColorBrush x:Key="ButtonFg" Color="#1F65FF"/>
    <SolidColorBrush x:Key="ButtonBorder" Color="#33000000"/>

    <SolidColorBrush x:Key="Danger" Color="#E5484D"/>
    <SolidColorBrush x:Key="Success" Color="#30A46C"/>
    <SolidColorBrush x:Key="Warning" Color="#FFB224"/>

    <DropShadowEffect x:Key="CardShadow" BlurRadius="24" ShadowDepth="0" Direction="270" Opacity="0.14" Color="#000000"/>
</ResourceDictionary>
